# ==============================================================================
# CampusEats Root Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate for your setup.
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
# Async driver connection string used by FastAPI application
DATABASE_URL=postgresql+asyncpg://campuseats:campuseats_pass@localhost:5432/campuseats_db

# Synchronous driver connection string used by Alembic migrations
DATABASE_URL_SYNC=postgresql://campuseats:campuseats_pass@localhost:5432/campuseats_db

# Redis Configuration (Cache, shopping cart sessions, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Database (Student preference graph and ingredient network)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=campuseats_neo4j

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay Payment Gateway (Test Mode credentials)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Embedding Model (Sentence Transformers for semantic food item vector search)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Public Variables (for reference when creating frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
